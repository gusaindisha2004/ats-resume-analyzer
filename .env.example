# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key      # server-side only, bypasses RLS — never expose
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_JWT_SECRET=                    # only needed if your project issues HS256 tokens

# ── Groq ────────────────────────────────────────────────────────────────────
# https://console.groq.com — required; the resume parser is LLM-backed.
GROQ_API_KEY=your-groq-api-key

# ── Backend ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
