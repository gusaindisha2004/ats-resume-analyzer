# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co

# The "Secret" key (sb_secret_...), or legacy service_role. Server-side only:
# it bypasses row-level security. The publishable/anon key is NOT needed here —
# only the frontend uses that, as NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_KEY=your-secret-key

# Leave blank. Only needed if your project still issues HS256 access tokens —
# sign-in will say so explicitly if it does. Project Settings -> API -> JWT.
SUPABASE_JWT_SECRET=

# ── Groq ────────────────────────────────────────────────────────────────────
# https://console.groq.com — required; the resume parser is LLM-backed.
GROQ_API_KEY=your-groq-api-key

# Optional. Groq retires models periodically; override the default here if the
# configured one stops working. check_setup.py lists what your key can use.
GROQ_MODEL=openai/gpt-oss-120b

# ── Backend ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
